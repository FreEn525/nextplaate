{
  "code": "dk",
  "title": "Upload new license plate, Denmark",
  "action": "add",
  "typeMenu": "ctype",
  "layout": "type-menu",
  "visibleFrom": "site-script",
  "types": [
    {
      "id": "1",
      "label": "Regular plates",
      "visible": ["digit", "let", "fon"]
    },
    {
      "id": "2",
      "label": "Commercial vehicles",
      "class": "yellow-black-select",
      "visible": ["digit", "let", "fon"]
    },
    {
      "id": "3",
      "label": "Lower-taxed commercial vehicles",
      "visible": ["digit", "let", "fon"]
    },
    {
      "id": "4",
      "label": "Vanity Plates",
      "visible": ["b1", "b2", "b3", "b4", "b5", "b6", "b7", "fon"]
    },
    {
      "id": "5",
      "label": "1958/1966-1976 - system",
      "visible": ["let", "nomerpl", "fon"]
    },
    {
      "id": "6",
      "label": "Diplomatic",
      "class": "white-blue-select",
      "visible": ["digit", "let", "fon"]
    },
    {
      "id": "7",
      "label": "Export plates",
      "visible": ["digit", "fon"]
    },
    {
      "id": "8",
      "label": "Temporary License plates",
      "visible": ["digit", "fon"]
